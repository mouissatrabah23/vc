# Workspace packages are symlinked instead of fetched from the registry.
link-workspace-packages=true
prefer-workspace-packages=true

# Peer deps: install automatically, but never fail the install on a mismatch.
auto-install-peers=true
strict-peer-dependencies=false

# Keep the strict (non-hoisted) node_modules layout — it catches undeclared
# dependencies at dev time instead of in a production container.
shamefully-hoist=false
