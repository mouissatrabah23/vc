# =============================================================================
#  ROOT ENVIRONMENT FILE  —  copy to `.env` and fill in real values
# =============================================================================
#
#   cp .env.example .env
#
# This single root `.env` is the source of truth for every workspace:
#
#   apps/api      -> loaded + validated by apps/api/src/env.ts    (dotenv + zod)
#   apps/worker   -> loaded + validated by apps/worker/src/env.ts (dotenv + zod)
#   apps/web      -> loaded by apps/web/next.config.mjs before Next.js builds
#   packages/db   -> loaded by dotenv-cli inside its prisma:* npm scripts
#
# RULES
#   * `.env` is git-ignored. Never commit real secrets.
#   * Anything named NEXT_PUBLIC_* is inlined into the browser bundle at build
#     time. Treat those values as fully public. Never put a service key there.
#   * Missing/invalid required vars make apps/api and apps/worker exit on boot
#     with a readable error instead of failing later at runtime.
#
# =============================================================================


# -----------------------------------------------------------------------------
# 1. RUNTIME
# -----------------------------------------------------------------------------

# development | test | production. Drives logger format, error verbosity, and
# whether the Prisma client is cached on globalThis across HMR reloads.
NODE_ENV=development

# trace | debug | info | warn | error | fatal. Pino level for api + worker.
LOG_LEVEL=debug


# -----------------------------------------------------------------------------
# 2. SERVICE URLS & PORTS
# -----------------------------------------------------------------------------

# Port the Express API binds to (apps/api).
API_PORT=4000

# Absolute base URL of the API, as reachable from *server-side* code.
# Local: http://localhost:4000 — in docker-compose: http://api:4000
API_URL=http://localhost:4000

# Absolute base URL of the Next.js app. Used for CORS allow-listing on the API
# and for building redirect/callback URLs (Chargily success/failure, auth).
WEB_URL=http://localhost:3000

# Same API base URL, but exposed to the browser bundle. Public by definition.
NEXT_PUBLIC_API_URL=http://localhost:4000


# -----------------------------------------------------------------------------
# 3. DATABASE  (local Postgres from docker-compose, or Supabase in staging/prod)
# -----------------------------------------------------------------------------

# Connection string Prisma uses for queries at runtime.
#
#   LOCAL (docker-compose service `postgres`, see docker-compose.yml):
#     postgresql://postgres:postgres@localhost:5432/saas_dev?schema=public
#
#   SUPABASE: use the *pooled* connection (Transaction mode, port 6543) and add
#   `?pgbouncer=true&connection_limit=1` so Prisma does not open a connection
#   pool on top of PgBouncer's pool:
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_dev?schema=public

# Direct (non-pooled) connection. Prisma Migrate needs a real session — it
# cannot run DDL through PgBouncer's transaction pooler.
#
#   LOCAL: identical to DATABASE_URL.
#   SUPABASE: the direct connection on port 5432:
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/saas_dev?schema=public


# -----------------------------------------------------------------------------
# 4. SUPABASE  (auth, storage metadata, realtime)
# -----------------------------------------------------------------------------

# Project REST/Auth endpoint: Supabase dashboard -> Project Settings -> API.
# Format: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# `anon` public key. Safe to ship to the browser: it is scoped by Row Level
# Security, so RLS policies must be enabled on every table it can reach.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# `service_role` key — bypasses ALL Row Level Security. Server-side only
# (apps/api, apps/worker). If this ever reaches the browser, rotate it.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT signing secret (Project Settings -> API -> JWT Settings). The API uses it
# to verify Supabase-issued access tokens locally, with no round-trip to Auth.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret


# -----------------------------------------------------------------------------
# 5. REDIS  (BullMQ queue backing store — shared by apps/api and apps/worker)
# -----------------------------------------------------------------------------

# LOCAL (docker-compose service `redis`): redis://localhost:6379
# Managed (Upstash/Redis Cloud) uses TLS:  rediss://default:<password>@<host>:<port>
#
# NOTE: BullMQ requires `maxRetriesPerRequest: null` on the ioredis connection;
# that is set for you in apps/api/src/queue.ts and apps/worker/src/redis.ts.
REDIS_URL=redis://localhost:6379

# Namespace prefix for every BullMQ key. Keeping envs on one Redis instance
# apart (e.g. `saas:dev`, `saas:staging`) avoids cross-env job leakage.
QUEUE_PREFIX=saas:dev


# -----------------------------------------------------------------------------
# 6. CHARGILY PAY  (payments — EDAHABIA / CIB, Algeria)
# -----------------------------------------------------------------------------

# test | live. Selects the Chargily API base URL and which key pair is valid.
CHARGILY_MODE=test

# Secret API key from the Chargily dashboard -> Developers.
# Looks like `test_sk_...` / `live_sk_...`. Sent as `Authorization: Bearer`.
# Server-side only.
CHARGILY_API_KEY=test_sk_your_chargily_api_key

# Chargily webhook signing secret. Every incoming webhook carries a
# `signature` header = HMAC-SHA256(raw_request_body, CHARGILY_SECRET_KEY).
# Verify it against the RAW body (before JSON parsing) or the signature check
# will never match.
CHARGILY_SECRET_KEY=test_sk_your_chargily_secret_key

# API base URL. Override only if Chargily changes hosts or you proxy them.
CHARGILY_BASE_URL=https://pay.chargily.net/test/api/v2

# Where Chargily redirects the customer after a checkout attempt.
CHARGILY_SUCCESS_URL=http://localhost:3000/billing/success
CHARGILY_FAILURE_URL=http://localhost:3000/billing/failure

# Public URL Chargily POSTs webhooks to. Locally, tunnel it:
#   ngrok http 4000  ->  https://<id>.ngrok-free.app/api/v1/webhooks/chargily
CHARGILY_WEBHOOK_URL=http://localhost:4000/api/v1/webhooks/chargily


# -----------------------------------------------------------------------------
# 7. CLOUDFLARE R2  (S3-compatible object storage: uploads + rendered output)
# -----------------------------------------------------------------------------

# Cloudflare account ID (dashboard URL or R2 overview page).
R2_ACCOUNT_ID=your-cloudflare-account-id

# R2 API token credentials: R2 -> Manage API Tokens -> Create API Token.
# Scope the token to a single bucket with Object Read & Write.
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Bucket that holds source uploads and worker output artifacts.
R2_BUCKET=saas-media

# S3-compatible endpoint. Pass this as `endpoint` to @aws-sdk/client-s3 and set
# `region: "auto"` + `forcePathStyle: true`.
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com

# Public read base URL — the r2.dev subdomain or your custom domain. Used to
# build the URLs handed back to the browser. Leave empty to serve everything
# through presigned GET URLs instead.
R2_PUBLIC_BASE_URL=https://media.example.com

# Lifetime (seconds) of presigned upload/download URLs issued by the API.
R2_PRESIGN_TTL_SECONDS=900


# -----------------------------------------------------------------------------
# 8. WORKER RUNTIME  (apps/worker — BullMQ consumer, invokes krillinai-cli)
# -----------------------------------------------------------------------------

# How many jobs one worker process handles concurrently. krillinai-cli runs are
# CPU/IO heavy — keep this at or below the container CPU allocation.
WORKER_CONCURRENCY=2

# Absolute path to the krillinai-cli binary inside the container. Must match
# where apps/worker/Dockerfile installs the Go binary it builds from source.
KRILLINAI_CLI_PATH=/usr/local/bin/krillinai-cli

# Where entrypoint.sh writes the rendered config.toml. The CLI is pointed at
# this path; it holds provider keys and is created mode 0600.
KRILLINAI_CONFIG_PATH=/app/config/config.toml

# Scratch directory for downloads and CLI output. Must be writable by the
# non-root krillin user (uid 10001). One subdirectory per job, removed when
# the job settles.
JOB_WORKDIR=/app/work

# Hard timeout (ms) for a single krillinai-cli invocation. The child process is
# killed and the job fails, rather than pinning a worker slot forever.
KRILLINAI_TIMEOUT_MS=1800000


# -----------------------------------------------------------------------------
# 9. KRILLINAI PROVIDER CREDENTIALS
# -----------------------------------------------------------------------------
# These are NOT read by the Node worker. entrypoint.sh substitutes them into
# config.toml when the container starts, which is why they are never baked into
# an image layer: anyone able to pull the image could otherwise read them with
# `docker history` or by extracting a layer.

# LLM key used for translation and subtitle rewriting. Goes to [llm].api_key.
# An OpenAI key, or any OpenAI-compatible provider key (DeepSeek, Groq,
# OpenRouter, a local vLLM) — set KRILLINAI_LLM_BASE_URL to match.
KRILLINAI_LLM_API_KEY=sk-your-llm-provider-key

# Text-to-speech key used for dubbing. Goes to [tts.openai].api_key. Kept
# separate from the LLM key on purpose: TTS is commonly a different vendor, and
# splitting them limits the blast radius when one is rotated or leaked.
KRILLINAI_TTS_PROVIDER_KEY=sk-your-tts-provider-key

# Which TTS backend config.toml selects. `openai` uses the key above; `aliyun`
# needs the [tts.aliyun] block filled in instead.
KRILLINAI_TTS_PROVIDER=openai

# OpenAI-compatible endpoint and models. Defaults are applied in entrypoint.sh
# if left unset; override for a non-OpenAI provider.
KRILLINAI_LLM_BASE_URL=https://api.openai.com/v1
KRILLINAI_LLM_MODEL=gpt-4o-mini
KRILLINAI_TTS_MODEL=tts-1

# Speech-to-text. `openai` calls the Whisper API; `fasterwhisper` runs locally
# and downloads a model into /app/models on first use (mount that volume).
KRILLINAI_TRANSCRIBE_PROVIDER=openai
KRILLINAI_TRANSCRIBE_MODEL=whisper-1
# Defaults to KRILLINAI_LLM_API_KEY when unset — set it only if transcription
# bills to a different account.
# KRILLINAI_TRANSCRIBE_API_KEY=

# Outbound proxy for the CLI, e.g. http://host.docker.internal:7890.
# Leave empty for a direct connection.
KRILLINAI_PROXY=

# Pipeline tuning, substituted into the [app] section of config.toml.
KRILLINAI_SEGMENT_DURATION=5
KRILLINAI_TRANSCRIBE_PARALLEL=1
KRILLINAI_TRANSLATE_PARALLEL=3


# -----------------------------------------------------------------------------
# 10. BUILD-TIME ARGS  (not read at runtime — passed to `docker build --build-arg`)
# -----------------------------------------------------------------------------
# The worker image builds krillinai-cli from source, so these pin WHAT gets
# built. Building requires network access to github.com.
#
#   docker build -f apps/worker/Dockerfile \
#     --build-arg KRILLINAI_REF="$KRILLINAI_REF" \
#     --build-arg YT_DLP_VERSION="$YT_DLP_VERSION" \
#     -t saas-worker:local .

# Upstream commit to build. This is the commit that tag v2.1.0 (2026-06-17)
# points at. NEVER set this to `master` — an unpinned branch means the same
# `docker build` silently produces a different binary tomorrow. Prefer a full
# commit SHA over a tag, because tags can be force-moved and SHAs cannot.
KRILLINAI_REF=5090acc9c3df28439237ec93d0667f39ad896989

# yt-dlp release used for remote source ingestion. Pinned for reproducibility,
# but bump it often: yt-dlp breaks as sites change, and a stale build is the
# usual cause of sudden download failures.
YT_DLP_VERSION=2026.08.19
